# Copy to /data/player/config.env and use your authorized station IDs.
# Config is sourced by Bash; single-quote literal values, especially LAYOUT.
API_BASE='https://venditt.com/api/v1/user'
ID='A,B,C'
IMAGE_SECONDS=15
MAX_CACHE_MB=30000
ORIENTATION=0
WEB_STATION=''
UNMUTED_ID=''

# Optional: empty preserves the existing automatic layout / renderer selection.
# | = side by side, / = top to bottom. Parentheses group; :weights are relative.
# LAYOUT='A | (B / C)'
# LAYOUT='(A | B) / C'
# LAYOUT='A:70 | (B / C):30'
# Advanced: LAYOUT='base64url:ENCODED_VALUE' (v1 JSON; see docs/playback-modes.md).
# Every ID must appear exactly once; repeated stations are public-link-only.
LAYOUT=''
