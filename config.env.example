# Copy to /data/player/config.env and use your authorized station IDs.
# Config is sourced by Bash; single-quote literal values.
API_BASE='https://venditt.com/api/v1/user'
# Regular or backend-defined layout station IDs; separate multiple IDs with commas.
ID='A,B,C'
IMAGE_SECONDS=15
MAX_CACHE_MB=30000
ORIENTATION=0
WEB_STATION=''
# One top-level or nested layout station to unmute; blank keeps Chromium ads muted.
UNMUTED_ID=''
